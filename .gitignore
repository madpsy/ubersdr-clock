# CMake build trees. build/ is the native one (make, ./build.sh --native);
# build-amd64/ and build-arm64/ are the per-arch container builds ./build.sh
# makes — a CMake cache is not portable between architectures, so they cannot
# share one tree.
build/
build-*/

# Arch-suffixed binaries (e.g. ubersdr-clock_amd64, ubersdr-clock_arm64)
ubersdr-clock_*

# Plain binary if ever built without the arch suffix
ubersdr-clock

*.o
*.a
